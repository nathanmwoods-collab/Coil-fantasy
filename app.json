{
  "expo": {
    "name": "Coil",
    "slug": "coil-fantasy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Coil uses your photos so you can set team and league images.",
          "cameraPermission": "Coil uses your camera so you can take a team or league photo."
        }
      ]
    ],
    "scheme": "coilfantasy",
    "experiments": {
      "typedRoutes": false
    }
  }
}